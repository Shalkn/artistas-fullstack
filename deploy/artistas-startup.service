[Unit]
Description=Startup stack Artistas + Tailscale Funnel
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=renan
WorkingDirectory=/home/renan/artistas-fullstack
Environment=DEPLOY_PATH=/home/renan/artistas-fullstack
Environment=COMPOSE_FILES=-f docker-compose.yml -f docker-compose.prod.yml
Environment=FUNNEL_TARGET=http://127.0.0.1:80
Environment=FUNNEL_HTTPS_PORT=443
ExecStart=/home/renan/artistas-fullstack/scripts/start-server.sh
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
