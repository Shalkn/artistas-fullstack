# Copie para .env na VM ou na sua máquina (não versionar .env com segredos reais).
# Documentação das variáveis: README principal do repositório (variáveis de ambiente).

# --- PostgreSQL (serviço db) ---
POSTGRES_USER=artistas
POSTGRES_PASSWORD=trocar_senha_forte
POSTGRES_DB=artistas

# --- MinIO (S3-compatible; serviço minio) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=trocar_senha_forte
S3_BUCKET=artistas-covers

# --- API Spring Boot (serviço api) ---
# JWT HS256: use string longa e aleatória em produção/lab exposto (>= 32 caracteres recomendado).
JWT_SECRET=trocar_jwt_secret_longo_minimo_32_caracteres

# Origens permitidas pelo Spring (CORS). Inclua a URL pública do front (ex.: Tailscale Funnel https://no.ts.net).
# Separe várias origens por vírgula, sem espaços extras se possível.
APP_CORS_ALLOWED_ORIGINS=https://seu-no.ts.net,http://localhost,http://127.0.0.1
